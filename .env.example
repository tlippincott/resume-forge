# Resume Forge Configuration
# Copy this file to .env and fill in your values

# ===== REQUIRED =====
# OpenAI API key (get from https://platform.openai.com/api-keys)
API_KEY=your-api-key-here

# ===== API CONFIGURATION =====
# OpenAI model to use (default: gpt-4o-mini)
MODEL_NAME=gpt-4o-mini

# Custom API base URL (optional, leave commented for default OpenAI endpoint)
# API_BASE_URL=https://api.openai.com/v1

# Default timeout for API calls in seconds (default: 60)
# DEFAULT_TIMEOUT=60

# Maximum retry attempts for failed API calls (default: 3)
# MAX_RETRIES=3

# Initial retry delay in seconds (default: 2)
# INITIAL_RETRY_DELAY=2

# Maximum retry delay in seconds (default: 32)
# MAX_RETRY_DELAY=32

# ===== LLM PARAMETERS =====
# Temperature for deterministic operations like scoring (default: 0.0)
# LLM_TEMPERATURE_DETERMINISTIC=0.0

# Temperature for creative operations like rewriting (default: 0.7)
# LLM_TEMPERATURE_CREATIVE=0.7

# Timeout for bullet scoring operations in seconds (default: 90)
# LLM_SCORING_TIMEOUT=90

# Timeout for bullet rewriting operations in seconds (default: 120)
# LLM_REWRITING_TIMEOUT=120

# Timeout for intelligence analysis operations in seconds (default: 60)
# LLM_ANALYSIS_TIMEOUT=60

# Timeout for cover letter generation in seconds (default: 90)
# LLM_COVER_LETTER_TIMEOUT=90

# ===== BUSINESS RULES =====
# Minimum bullets to select from library (default: 38)
# BUSINESS_BULLET_SELECTION_MIN=38

# Maximum bullets to select from library (default: 42)
# BUSINESS_BULLET_SELECTION_MAX=42

# SPINS section bullet limits (default: 10-12)
# BUSINESS_SPINS_MIN=10
# BUSINESS_SPINS_MAX=12

# Programmer section bullet limits (default: 10-12)
# BUSINESS_PROGRAMMER_MIN=10
# BUSINESS_PROGRAMMER_MAX=12

# Analyst section bullet limits (default: 0-unlimited, overflow section)
# BUSINESS_ANALYST_MIN=0
# BUSINESS_ANALYST_MAX=  (leave empty for unlimited)

# ===== SCORING WEIGHTS =====
# Weight for required skill matches (default: 3)
# SCORING_REQUIRED_SKILL_WEIGHT=3

# Weight for preferred skill matches (default: 1)
# SCORING_PREFERRED_SKILL_WEIGHT=1

# Bonus for bullets with quantified impact (default: 2)
# SCORING_IMPACT_BONUS=2

# Weight for category similarity in replacements (default: 2)
# SCORING_CATEGORY_SIMILARITY_WEIGHT=2

# Weight for skill overlap in replacements (default: 1)
# SCORING_SKILL_OVERLAP_WEIGHT=1

# Penalty per duplicated skill in replacements (default: 0.5)
# SCORING_SKILL_COVERAGE_PENALTY=0.5

# ===== LOGGING =====
# Root log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
# LOG_LEVEL=INFO

# Log directory path (default: logs)
# LOG_DIR=logs

# Log file name (default: resume_forge.log)
# LOG_FILENAME=resume_forge.log

# Console handler log level (default: INFO)
# LOG_CONSOLE_LEVEL=INFO

# File handler log level (default: DEBUG)
# LOG_FILE_LEVEL=DEBUG

# ===== OUTPUT =====
# Resume PDF filename (without .pdf extension)
OUTPUT_RESUME_PDF_NAME=Firstname Lastname Resume 2026

# Cover letter PDF filename (without .pdf extension)
OUTPUT_COVER_LETTER_PDF_NAME=Firstname Lastname Cover Letter

# ===== ENVIRONMENT =====
# Set to 'development' or 'production' for environment-specific overrides
# (Currently for documentation only - future enhancement)
# ENV=development
